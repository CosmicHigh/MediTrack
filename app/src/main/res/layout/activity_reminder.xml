<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reminderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reminder_screen_bg">

    <LinearLayout
        android:id="@+id/reminderContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/reminderIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:gravity="center"
            android:background="@drawable/reminder_icon_bg"
            android:text="☼"
            android:textColor="#F4C460"
            android:textSize="38sp"
            android:fontFamily="sans-serif"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/reminderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Time for your medicine"
            android:textColor="#F8FBFC"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="3dp"
            android:maxLines="2" />

        <TextView
            android:id="@+id/reminderSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/reminder_slot_bg"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="সকাল  ·  Morning"
            android:textColor="#F4C460"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />

        <ScrollView
            android:id="@+id/reminderScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="26dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/glassPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/reminder_card_bg"
                android:elevation="10dp"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/medicineListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/reminder_button_bg"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0"
            android:minHeight="70dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:stateListAnimator="@null"
            android:text="Dismiss alarm"
            android:textAllCaps="false"
            android:textColor="#09201F"
            android:textSize="21sp" />

    </LinearLayout>

</FrameLayout>
